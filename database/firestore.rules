rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Collection "products": each document has EXACTLY 4 fields.
    match /products/{productId} {
      function validProduct() {
        let d = request.resource.data;
        return d.keys().hasOnly(['name', 'price', 'soluong', 'image'])
          && d.keys().hasAll(['name', 'price', 'soluong', 'image'])
          && d.name is string && d.name.size() > 0 && d.name.size() <= 100
          && d.price is number && d.price >= 0
          && d.soluong is int && d.soluong >= 0
          && d.image is string;
      }

      allow read: if request.auth != null;
      allow create, update: if request.auth != null && validProduct();
      allow delete: if request.auth != null;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
